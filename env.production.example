# Production template. Copy to .env ON THE BOX, at the repo root, fill in every
# CHANGE_ME and never commit the result:
#
#   cp env.production.example .env && chmod 600 .env
#
# One file feeds two consumers. The keys under "Container stack" are read by
# docker/docker-compose.prod.yml when it is passed as --env-file, everything
# else is read by the api container through env_file and maps to a field in
# app/infra/config.py. That is why the Postgres and Redis credentials appear
# twice: once for the container that starts the datastore, once inside the URL
# the app dials it with. They have to match.
#
#   docker compose --env-file .env -f docker/docker-compose.prod.yml up -d
#
# Generate each secret below with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# App

ENVIRONMENT=production

# never true in prod, it turns on FastAPI's debug tracebacks
DEBUG=false

# Container stack (docker/docker-compose.prod.yml only, no Settings field)

# the GHCR tag to run. Use the commit sha CI built, not "latest": an immutable
# tag makes `up -d` actually pull, and a rollback is the old sha plus one `up -d`
IMAGE_TAG=CHANGE_ME

# the certificate is issued for this name, so its A/AAAA record has to point at
# the box before the first `up`. Let's Encrypt expiry notices go to ACME_EMAIL
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# uvicorn workers. The connection ceiling is
# WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW): 4 x (8 + 4) = 48, under
# the 100 Postgres allows by default
WEB_CONCURRENCY=4

# hard memory caps (docker compose deploy.resources.limits), tune to the box's
# actual RAM
CADDY_MEMORY_LIMIT=256m
API_MEMORY_LIMIT=2g
DB_MEMORY_LIMIT=2g
REDIS_MEMORY_LIMIT=512m

# the api entrypoint runs `alembic upgrade head` before serving. Set false
# before running a second api container against the same database, otherwise
# two of them race for the same alembic_version row
RUN_MIGRATIONS=true

# Database (Postgres)

POSTGRES_USER=relayix
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=relayix

# host is the compose service name, not localhost. Must carry the same
# user/password/db as the three keys above, URL-encode the password if it
# contains @ : / or ?
DATABASE_URL=postgresql+asyncpg://relayix:CHANGE_ME@db:5432/relayix

# libpq-style TLS mode. "disable" is the honest value while Postgres runs on
# the internal compose network: there is no transport off the box to protect.
# Switch to "require" the day the database moves to managed Postgres
DB_SSL=disable

# per worker, see WEB_CONCURRENCY above
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT_S=30.0
DB_POOL_RECYCLE_S=3600
DB_POOL_PRE_PING=true

# never true in prod, it logs every statement and its parameters
DB_ECHO=false

DB_CONNECT_TIMEOUT_S=10.0
DB_COMMAND_TIMEOUT_S=60.0
DB_STATEMENT_TIMEOUT_MS=30000

# Admin

# bearer token gating the api-key management endpoints (create/list/revoke)
ADMIN_API_TOKEN=CHANGE_ME

# Provider credentials
# a provider is only registered when its key is set (app/core/adapters/registry.py)

OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME

# how long to wait on an upstream provider before giving up (seconds)
PROVIDER_TIMEOUT_S=40.0

# deadline for a single readiness dependency check, deliberately much shorter
# than the db/redis timeouts above
HEALTH_CHECK_TIMEOUT_S=2.0

# fallback limit for keys that don't specify their own rate_limit_rpm
DEFAULT_RATE_LIMIT_RPM=60

# Redis (rate limiting + idempotency)

REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=256mb

# host is the compose service name, and the password must match
# REDIS_PASSWORD above. Note the leading colon, the user half is empty
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

REDIS_CONNECT_TIMEOUT_S=2.0
REDIS_COMMAND_TIMEOUT_S=2.0
REDIS_MAX_CONNECTIONS=50

# circuit breaker guarding Redis itself: when Redis is unreachable we stop
# calling it (open) and serve from the in-memory limiter until it recovers
RATELIMIT_BREAKER_FAIL_THRESHOLD=3
RATELIMIT_BREAKER_RESET_TIMEOUT_S=10.0

IDEMPOTENCY_INFLIGHT_TTL_S=120
# how long a completed response stays replayable for client retries (24h)
IDEMPOTENCY_TTL_S=86400

# consecutive failures before a provider is taken out of rotation (open)
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
# how long to stay open before a single test request is allowed (half-open)
CIRCUIT_BREAKER_RESET_TIMEOUT_S=30.0
