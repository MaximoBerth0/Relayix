# Copy to .env and fill in the provider keys. See app/infra/config.py for the
# full list of settings and their defaults.

# app 
ENVIRONMENT=development
DEBUG=false

# database (consumed by app/infra/database/session.py)
DATABASE_URL=postgresql+asyncpg://postgres:relayix@localhost:5432/relayix_db
# the local postgres container serves plaintext; use "require" against RDS
DB_SSL=disable
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30.0
DB_POOL_RECYCLE_S=1800
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT_S=10.0
DB_COMMAND_TIMEOUT_S=30.0
DB_STATEMENT_TIMEOUT_MS=30000

# redis (rate limiting + idempotency) 
REDIS_URL=redis://localhost:6379/0

# provider credentials 
# a provider is only registered when its key is set (app/core/adapters/registry.py)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
